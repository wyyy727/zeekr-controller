# 环境变量模板
#
# 使用方式：
#   cp .env.example .env
#   然后填入你的真实值
#
# ⚠️ .env 已被 .gitignore 忽略，**绝不会被提交到仓库**。

# ─────────── 服务配置 ───────────
APP_HOST=0.0.0.0
APP_PORT=8765
APP_DEBUG=false

# 数据源：auto / mock / live
#   auto —— 配置齐全则走真实接口，否则回落模拟数据（默认）
#   mock —— 强制模拟数据（用于开发调试）
#   live —— 强制真实接口
DATA_SOURCE=auto

# 车控指令总开关。默认 false（只读）。
# 确认需要远程控制时再改为 true —— 避免误操作。
ALLOW_COMMANDS=false

# 轮询间隔（秒）
POLL_INTERVAL_IDLE=300      # 空闲时 5 分钟
POLL_INTERVAL_CHARGING=60   # 充电中 1 分钟

# ─────────── 极氪国区账号 ───────────
# 极氪 App 注册的大陆手机号（11 位）
ZEEKR_PHONE=

# ─────────── 密钥（从官方安卓 APK 提取）───────────
#
# 提取工具：https://github.com/wysie/zeekr_key_extractor
# 命令：python zeekr_extract_secrets.py base.apk arm64.apk --region CN
#
# ⚠️ 密钥是账号凭证，请勿分享、勿提交到仓库。
# ⚠️ App 升级后密钥可能失效，届时需重新提取。

ZEEKR_HMAC_ACCESS_KEY=
ZEEKR_HMAC_SECRET_KEY=
ZEEKR_PASSWORD_PUBLIC_KEY=
ZEEKR_PROD_SECRET=
ZEEKR_VIN_KEY=
ZEEKR_VIN_IV=

# 可选：从 App 抓包得到的 X-VIN 令牌
# 部分车型的 GW3 实时状态与远程控制需要它。留空则用本地 AES 加密的 VIN。
ZEEKR_VEHICLE_TOKEN=
