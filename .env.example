# 环境变量模板
#
# 使用方式：
#   cp .env.example .env
#   然后填入你的真实值
#
# ⚠️ .env 已被 .gitignore 忽略，**绝不会被提交到仓库**。
#
# 本文件是**唯一**的环境变量模板（2026-10-27 把 server/.env.example 合并进来了）。
# 服务端仍会按 `server/.env` → 仓库根 `.env` 的顺序查找并加载，先命中的生效，
# 所以把 .env 放在仓库根（推荐，也跟下面这行 cp 一致）或 server/ 下都能跑。

# ─────────── 服务配置 ───────────
APP_HOST=0.0.0.0
APP_PORT=8765
APP_DEBUG=false

# 数据源：auto / mock / live
#   auto —— 配置齐全则走真实接口，否则回落模拟数据（默认）
#   mock —— 强制模拟数据（用于开发调试）
#   live —— 强制真实接口
DATA_SOURCE=auto

# 车控指令总开关。默认 false（只读）。
# 确认需要远程控制时再改为 true —— 避免误操作。
ALLOW_COMMANDS=false

# 可选的 API 令牌。**留空即不启用鉴权**（默认，方便本地联调）。
#
# 强烈建议在开启车控（ALLOW_COMMANDS=true）时同时设置它 ——
# 服务端监听 0.0.0.0，不设令牌的话同一局域网内任何人都能
# POST /api/vehicle/command 解锁车辆。
#
# 设了之后：除 /api/health 外所有 /api/* 都需带
#   Authorization: Bearer <token>
# （浏览器打开 /preview 时可改用 ?token=<token>）
#
# 生成方式（任选）：openssl rand -hex 24
API_TOKEN=

# 轮询间隔（秒）
POLL_INTERVAL_IDLE=300      # 空闲时 5 分钟
POLL_INTERVAL_CHARGING=60   # 充电中 1 分钟

# 逐日电耗的保底同步（服务端进程内定时任务）
#
# 逐日电耗本来只在「打开行程页」时回源落库，连续几天不打开就攒不下来。
# 这个任务每 ENERGY_SYNC_INTERVAL_HOURS 小时拉一次最近 ENERGY_SYNC_DAYS 天，
# 写入是覆盖（同一天多次拉取不会翻倍）。
# 官方日统计单次最多 31 个自然日、只允许回查 60 天 —— 回看天数别超过 31。
# 留空即用代码内默认值：interval = 6（小时），days = 7；interval=0 关闭。
ENERGY_SYNC_INTERVAL_HOURS=
ENERGY_SYNC_DAYS=

# 跨域白名单（逗号分隔的完整来源，如 https://a.example.com,https://b.example.com）
# 留空 = `*`（默认，兼容 file:// 预览与局域网部署）；填了才收紧。
# 公网部署、又不想让任意网页调你的 /api/* 时再设。
CORS_ORIGINS=

# 可选：登录会话令牌的落盘位置（默认落在数据目录下的 session.json）
# 只有想把会话放到别处（例如容器挂载卷、共享盘）时才需要设。
ZEEKR_SESSION_FILE=

# ─────────── 密钥（从官方安卓 APK 提取）───────────
#
# 注：登录手机号**不在这里配置** —— 由客户端登录时输入
#     （预览页 → 设置 → 账号与凭据），服务端不保存也不依赖它。
#
# 提取工具（本仓库自带，纯静态提取，无需安卓设备）：
#   python scripts/extract_keys.py <极氪APK路径> --write-env
#
# ⚠️ 密钥是账号凭证，请勿分享、勿提交到仓库。
# ⚠️ App 升级后密钥可能失效，届时需重新提取。

ZEEKR_HMAC_ACCESS_KEY=
ZEEKR_HMAC_SECRET_KEY=
ZEEKR_PASSWORD_PUBLIC_KEY=
# ⚠️ GW3 的签名密钥**可能不是**提取器给出的那一个：
#     实测（2026-10-16）发现 `extract_keys.py` 输出的 119 个候选里
#     **没有**网关真正使用的值 —— 「逐个换候选」这条路走不通。
#     若 GW3 一直报 `079025 Signature authentication failed`，
#     说明密钥不对，需另寻（判定与来源见 docs/zeekr-implementation-diff.md）。
ZEEKR_PROD_SECRET=
# ⚠️ X-VIN 的 AES 密钥/IV 同理：提取器给出的值实测**不可用**
#     （网关回 `079025 Decrypt X-VIN failed`）。算法是
#     AES-128-CBC + PKCS7 + Base64（与提取器一致），错的只是密钥常量。
#     判定方法与正确取值见 docs/zeekr-implementation-diff.md。
#     判错的自检信号：车辆列表能拿到、但车况一律 079025 —— 那就是本组常量不对。
ZEEKR_VIN_KEY=
ZEEKR_VIN_IV=

# 可选：GW1 的客户端认证密钥（x_ca_secret）
#
# 这是官方 App 内置的常量，**与上面 6 个密钥不是同一套东西**：
#   - 上面 6 个 → GW2 / GW3（车数据与车控）
#   - 这一个   → GW1（短信验证码与手机号登录）
# 留空即用代码内的默认值（见 server/app/adapters/zeekr_signing.py 的 GW1_CA_SECRET）。
ZEEKR_CA_SECRET=

# 可选：从 App 抓包得到的 X-VIN 令牌
# 部分车型的 GW3 实时状态与远程控制需要它。留空则用本地 AES 加密的 VIN。
ZEEKR_VEHICLE_TOKEN=

# 可选：TSP 平台号 —— `/ms-app-bff/api/1.0/permissions` 的必填参数。
# 2026-10-16 真车枚举实测：非数字 → 000002 参数校验失败；1/2/3 → 037021 平台类型未定义；
# 4 → ok 但返回空数组；5 / 7 / 8 / 21..27 → ok 且返回该车 21 项权限（内容一致）。
# 留空即用代码内默认值 5。
ZEEKR_TSP_PLATFORM=

# ── 浩汉充电网关（第三方）—— 「附近充电站」的**价格**来源 ──────────────────
#
# 极氪 App 的充电地图内嵌的是浩汉能源（haohanpower.tech）的 SDK：
# 极氪侧的 getListV2 只给坐标、枪数与运营商 logo，**没有站名、没有电价**；
# 站名与分时电价都在浩汉网关，而那套认证与极氪毫无关系 —— 只要一个
# `channelId` 请求头，不需要登录、不需要签名、不需要 X-VIN。
#
# `channelId=1` 取自浩汉小程序前端的硬编码（{"sourceCode":4,"channelId":1}），
# 实测即极氪渠道。它是逆向得到的值，所以做成配置项 —— 对方改了渠道号时
# 应该改这里就能恢复，而不是等一次发版。
#
# 留空即用代码内默认值：
#   host      = https://gateway-prod.haohanpower.tech
#   channelId = 1
ZEEKR_HAOHAN_HOST=
ZEEKR_HAOHAN_CHANNEL_ID=

# ── 腾讯位置服务（车辆位置卡）──────────────────────────────
#
# 车坐标是 GCJ-02，合规上只能用腾讯/高德/百度/天地图（Apple 地图不能用于
# 大陆地图展示，所以 iOS 端也没法用 MapKit）。这里用腾讯。
#
# 申请入口：https://lbs.qq.com/dev/console/key/manage
#   · 创建 key 时勾选「WebServiceAPI」
#   · 需要启用的服务：逆地理编码（Geocoder）、静态图（StaticMap）
#   · 个人认证有免费日额度，够个人日常用
#
# key 只放服务端，前端通过 /api/vehicle/location/map.png 由后端代取图片，
# 不会出现在 HTML 里。
#
# 留空 ⇒ 位置卡降级：只显示坐标 + 上报时间，不请求腾讯、不显示地图。
# ⚠️ 填了这个键就意味着「车辆坐标会发给腾讯」，请确认你接受这一点。
TENCENT_MAP_KEY=

# ── 充电金额：截图识别（可选）──────────────────────────
# 极氪只给电量不给金额，金额要靠「充电订单截图」识别补录。
#
# 申请入口：https://platform.deepseek.com/api_keys
#   · 需要有视觉能力的模型（默认 deepseek-v4-flash-vision-exp）
#   · 按量计费，单张截图识别成本很低
#
# 隐私边界：截图只在服务端内存里转成 base64 发给上游，**不落盘、不进日志**；
# 识别结果回传前会剔掉 VIN / 车牌 / 手机号 / 完整订单号（只留订单后四位）。
#
# 留空 ⇒ 充电页的「截图识别」按钮降级为提示，**手写录入仍可用** —— 那条路零依赖。
DEEPSEEK_API_KEY=

# 可选：上游地址，默认 https://api.deepseek.com（只有走代理/自建网关才需要改）
DEEPSEEK_BASE_URL=
# 可选：换识别模型，默认 deepseek-v4-flash-vision-exp（**必须有视觉能力**）
DEEPSEEK_VISION_MODEL=

# ── 充电金额：估算兜底（可选）──────────────────────────
# 既没截图识别、也没手写金额时，用「充入电量 × 电价」给个估算值。
# 估算结果**不落库、只展示**，接口里单独计数，不会污染真实账目。
# 填每度电价格（元），如 0.8；留空或 0 = 关闭估算（没金额就显示没有）。
CHARGE_ESTIMATE_PRICE=
