# 环境变量模板
#
# 使用方式：
#   cp .env.example .env
#   然后填入你的真实值
#
# ⚠️ .env 已被 .gitignore 忽略，**绝不会被提交到仓库**。

# ─────────── 服务配置 ───────────
APP_HOST=0.0.0.0
APP_PORT=8765
APP_DEBUG=false

# 数据源：auto / mock / live
#   auto —— 配置齐全则走真实接口，否则回落模拟数据（默认）
#   mock —— 强制模拟数据（用于开发调试）
#   live —— 强制真实接口
DATA_SOURCE=auto

# 车控指令总开关。默认 false（只读）。
# 确认需要远程控制时再改为 true —— 避免误操作。
ALLOW_COMMANDS=false

# 可选的 API 令牌。**留空即不启用鉴权**（默认，方便本地联调）。
#
# 强烈建议在开启车控（ALLOW_COMMANDS=true）时同时设置它 ——
# 服务端监听 0.0.0.0，不设令牌的话同一局域网内任何人都能
# POST /api/vehicle/command 解锁车辆。
#
# 设了之后：除 /api/health 外所有 /api/* 都需带
#   Authorization: Bearer <token>
# （浏览器打开 /preview 时可改用 ?token=<token>）
#
# 生成方式（任选）：openssl rand -hex 24
API_TOKEN=

# 轮询间隔（秒）
POLL_INTERVAL_IDLE=300      # 空闲时 5 分钟
POLL_INTERVAL_CHARGING=60   # 充电中 1 分钟

# ─────────── 密钥（从官方安卓 APK 提取）───────────
#
# 注：登录手机号**不在这里配置** —— 由客户端登录时输入
#     （预览页 → 设置 → 账号与凭据），服务端不保存也不依赖它。
#
# 提取工具（本仓库自带，纯静态提取，无需安卓设备）：
#   python scripts/extract_keys.py <极氪APK路径> --write-env
#
# ⚠️ 密钥是账号凭证，请勿分享、勿提交到仓库。
# ⚠️ App 升级后密钥可能失效，届时需重新提取。

ZEEKR_HMAC_ACCESS_KEY=
ZEEKR_HMAC_SECRET_KEY=
ZEEKR_PASSWORD_PUBLIC_KEY=
# ⚠️ GW3 的签名密钥**可能不是**提取器给出的那一个：
#     实测（2026-10-16）发现 `extract_keys.py` 输出的 119 个候选里
#     **没有**网关真正使用的值 —— 「逐个换候选」这条路走不通。
#     若 GW3 一直报 `079025 Signature authentication failed`，
#     说明密钥不对，需另寻（判定与来源见 docs/zeekr-implementation-diff.md）。
ZEEKR_PROD_SECRET=
# ⚠️ X-VIN 的 AES 密钥/IV 同理：提取器给出的值实测**不可用**
#     （网关回 `079025 Decrypt X-VIN failed`）。算法是
#     AES-128-CBC + PKCS7 + Base64（与提取器一致），错的只是密钥常量。
#     判定方法与正确取值见 docs/zeekr-implementation-diff.md。
#     判错的自检信号：车辆列表能拿到、但车况一律 079025 —— 那就是本组常量不对。
ZEEKR_VIN_KEY=
ZEEKR_VIN_IV=

# 可选：GW1 的客户端认证密钥（x_ca_secret）
#
# 这是官方 App 内置的常量，**与上面 6 个密钥不是同一套东西**：
#   - 上面 6 个 → GW2 / GW3（车数据与车控）
#   - 这一个   → GW1（短信验证码与手机号登录）
# 留空即用代码内的默认值（见 server/app/adapters/zeekr_signing.py 的 GW1_CA_SECRET）。
ZEEKR_CA_SECRET=

# 可选：从 App 抓包得到的 X-VIN 令牌
# 部分车型的 GW3 实时状态与远程控制需要它。留空则用本地 AES 加密的 VIN。
ZEEKR_VEHICLE_TOKEN=

# 可选：TSP 平台号 —— `/ms-app-bff/api/1.0/permissions` 的必填参数。
# 2026-10-16 真车枚举实测：非数字 → 000002 参数校验失败；1/2/3 → 037021 平台类型未定义；
# 4 → ok 但返回空数组；5 / 7 / 8 / 21..27 → ok 且返回该车 21 项权限（内容一致）。
# 留空即用代码内默认值 5。
ZEEKR_TSP_PLATFORM=

# ── 浩汉充电网关（第三方）—— 「附近充电站」的**价格**来源 ──────────────────
#
# 极氪 App 的充电地图内嵌的是浩汉能源（haohanpower.tech）的 SDK：
# 极氪侧的 getListV2 只给坐标、枪数与运营商 logo，**没有站名、没有电价**；
# 站名与分时电价都在浩汉网关，而那套认证与极氪毫无关系 —— 只要一个
# `channelId` 请求头，不需要登录、不需要签名、不需要 X-VIN。
#
# `channelId=1` 取自浩汉小程序前端的硬编码（{"sourceCode":4,"channelId":1}），
# 实测即极氪渠道。它是逆向得到的值，所以做成配置项 —— 对方改了渠道号时
# 应该改这里就能恢复，而不是等一次发版。
#
# 留空即用代码内默认值：
#   host      = https://gateway-prod.haohanpower.tech
#   channelId = 1
ZEEKR_HAOHAN_HOST=
ZEEKR_HAOHAN_CHANNEL_ID=
