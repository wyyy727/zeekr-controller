# ZeekrDash 服务端配置示例
#
# 复制为 .env 并填入真实值。**切勿提交到版本库。**

# ── 6 个密钥（从官方安卓 APK 提取）────────────────
# 登录手机号**不在这里配置** —— 由客户端登录时输入（设置页 → 账号与凭据）。
# 仍强烈建议用独立的子账号并共享车辆，避免与手机 App 会话冲突。
#
# 提取工具（本仓库自带，纯静态提取，无需安卓设备）：
# 用法：python scripts/extract_keys.py <极氪APK路径> --write-env
ZEEKR_HMAC_ACCESS_KEY=
ZEEKR_HMAC_SECRET_KEY=
ZEEKR_PASSWORD_PUBLIC_KEY=
ZEEKR_PROD_SECRET=
# ⚠️ 上面两项（PROD_SECRET、VIN_KEY/IV）实测都与提取器输出不一致：
#    · PROD_SECRET 不在提取器的 119 个候选里
#    · VIN_KEY/IV 用提取器的值会一直 `079025 Decrypt X-VIN failed`
#    详见仓库根的 .env.example 与 docs/zeekr-implementation-diff.md。
ZEEKR_VIN_KEY=
ZEEKR_VIN_IV=

# ── 可选：X-VIN 令牌 ─────────────────────────────
# 部分车型的 GW3 实时状态/车控需要，从 App 抓包获取
# 抓包工具：HTTP Toolkit / Proxyman / Charles
# 复制任意 snc-tsp-api.zeekrlife.com 请求里的 X-VIN 头值
ZEEKR_VEHICLE_TOKEN=

# 可选：TSP 平台号 —— `/ms-app-bff/api/1.0/permissions` 的必填参数。
# 2026-10-16 真车枚举实测：非数字 → 000002 参数校验失败；1/2/3 → 037021 平台类型未定义；
# 4 → ok 但返回空数组；5 / 7 / 8 / 21..27 → ok 且返回该车 21 项权限（内容一致）。
# 留空即用代码内默认值 5。
ZEEKR_TSP_PLATFORM=

# ── 浩汉充电网关（第三方）—— 「附近充电站」的**价格**来源 ──────────────────
#
# 极氪 App 的充电地图内嵌的是浩汉能源（haohanpower.tech）的 SDK：
# 极氪侧的 getListV2 只给坐标、枪数与运营商 logo，**没有站名、没有电价**；
# 站名与分时电价都在浩汉网关，而那套认证与极氪毫无关系 —— 只要一个
# `channelId` 请求头，不需要登录、不需要签名、不需要 X-VIN。
#
# `channelId=1` 取自浩汉小程序前端的硬编码（{"sourceCode":4,"channelId":1}），
# 实测即极氪渠道。它是逆向得到的值，所以做成配置项 —— 对方改了渠道号时
# 应该改这里就能恢复，而不是等一次发版。
#
# 留空即用代码内默认值：
#   host      = https://gateway-prod.haohanpower.tech
#   channelId = 1
ZEEKR_HAOHAN_HOST=
ZEEKR_HAOHAN_CHANNEL_ID=

# ── 可选：逐日电耗保底同步 ─────────────────────────
#
# 逐日电耗本来只在"打开行程页"时回源落库，连续几天不打开就攒不下来。
# 服务端启动后会跑一个进程内定时任务兜底：每 ENERGY_SYNC_INTERVAL_HOURS
# 小时拉一次最近 ENERGY_SYNC_DAYS 天，写入是覆盖（同一天多次拉取不会翻倍）。
#
# 官方日统计单次最多 31 个自然日、只允许回查 60 天，所以回看天数别超过 31。
# 留空即用代码内默认值：interval = 6（小时），days = 7；interval=0 关闭。
ENERGY_SYNC_INTERVAL_HOURS=
ENERGY_SYNC_DAYS=
