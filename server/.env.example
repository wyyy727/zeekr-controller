# ZeekrDash 服务端配置示例
#
# 复制为 .env 并填入真实值。**切勿提交到版本库。**

# ── 极氪账号 ──────────────────────────────────────
# 中国大陆手机号（11 位）
# 强烈建议使用独立的子账号并共享车辆，避免与手机 App 会话冲突
ZEEKR_PHONE=

# ── 6 个密钥（从官方安卓 APK 提取）────────────────
# 提取工具：https://github.com/wysie/zeekr_key_extractor
# 用法：python zeekr_extract_secrets.py base.apk arm64.apk --region CN
ZEEKR_HMAC_ACCESS_KEY=
ZEEKR_HMAC_SECRET_KEY=
ZEEKR_PASSWORD_PUBLIC_KEY=
ZEEKR_PROD_SECRET=
ZEEKR_VIN_KEY=
ZEEKR_VIN_IV=

# ── 可选：X-VIN 令牌 ─────────────────────────────
# 部分车型的 GW3 实时状态/车控需要，从 App 抓包获取
# 抓包工具：HTTP Toolkit / Proxyman / Charles
# 复制任意 snc-tsp-api.zeekrlife.com 请求里的 X-VIN 头值
ZEEKR_VEHICLE_TOKEN=

# ── 服务配置 ─────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8765
APP_DEBUG=false

# 数据源：auto（配置齐全走真实接口）/ mock / live
DATA_SOURCE=auto

# 车控指令总开关 —— 默认关闭，只读模式更安全
ALLOW_COMMANDS=false

# 轮询间隔（秒）
POLL_INTERVAL_IDLE=300
POLL_INTERVAL_CHARGING=60
